{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenQuota",
  "version": "0.7.0",
  "identifier": "io.github.deviffyy.openquota",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenQuota",
        "width": 320,
        "height": 800,
        "minWidth": 320,
        "minHeight": 240,
        "maxWidth": 520,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyQUYxRkFEQjREODIzNDEKUldSQkk5aTByUit2c3JqbllTNWFYTGRTbkpnbGhqd2g4OHU5UE5LSVlPbXIrd1RIeUwvODhISDAK",
      "endpoints": ["https://github.com/Aice-Chen/OpenQuota/releases/latest/download/latest.json"]
    }
  }
}
